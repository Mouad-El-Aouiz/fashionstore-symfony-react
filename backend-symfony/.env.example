APP_ENV=dev
APP_SECRET=change-this-local-secret
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
MAILER_DSN=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL="FashionStore <no-reply@fashionstore.local>"
FRONTEND_URL=http://localhost:5173
DEFAULT_URI=http://localhost:8001
APP_PORT=8001

POSTGRES_VERSION=16
POSTGRES_PORT=5433
POSTGRES_DB=fashion_store
POSTGRES_USER=fashion_store
POSTGRES_PASSWORD=fashion_store_dev
DATABASE_URL="postgresql://fashion_store:fashion_store_dev@127.0.0.1:5433/fashion_store?serverVersion=16&charset=utf8"
