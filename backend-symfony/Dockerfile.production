FROM composer:2 AS dependencies

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --ignore-platform-req=ext-pdo_pgsql --no-scripts

COPY . .
RUN composer dump-autoload --no-dev --no-interaction --classmap-authoritative --no-scripts

FROM php:8.3-apache-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=dependencies /app /app
COPY docker/apache-vhost.conf /etc/apache2/sites-available/000-default.conf
COPY docker/entrypoint.sh /usr/local/bin/fashionstore-entrypoint
RUN chmod +x /usr/local/bin/fashionstore-entrypoint \
    && mkdir -p config/jwt var/cache var/log \
    && chown -R www-data:www-data var

ENV APP_ENV=prod \
    APP_DEBUG=0 \
    APACHE_DOCUMENT_ROOT=/app/public

EXPOSE 80

ENTRYPOINT ["fashionstore-entrypoint"]
CMD ["apache2-foreground"]
